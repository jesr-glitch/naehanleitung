# Pflicht für die Foto-Analyse. Ohne Schlüssel läuft die App mit Standardschnitten.
ANTHROPIC_API_KEY=

# Optional
PORT=3000
# Claude-Modell und Denktiefe (low | medium | high | xhigh | max). medium spart Kosten.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high
# Kostenbremse: Analysen pro IP und Stunde, und insgesamt pro Tag (0 = unbegrenzt)
ANALYZE_PER_HOUR=20
ANALYZE_PER_DAY=500
# 1 setzen, wenn ein Reverse Proxy (Render, Fly, Caddy, nginx) davor sitzt, damit die echte Client-IP zählt
TRUST_PROXY=1
